# Copiați acest fișier în server/.env și completați valorile.
PORT=3000
# Secret pentru semnarea token-urilor JWT. Generați unul lung și aleator; nu îl publicați.
JWT_SECRET=schimba-ma-cu-un-secret-lung
# Fișierul bazei de date SQLite (relativ la folderul server/)
DB_STORAGE=data/app.sqlite
# Originea frontend-ului permisă prin CORS
CLIENT_ORIGIN=http://localhost:5173
# Valabilitatea token-ului (inspectorul poate lucra offline câteva zile)
JWT_EXPIRES_IN=7d

# Pachetul EXT: registrul extern simulat (pornit cu: npm run registry)
REGISTRY_URL=http://localhost:4000
DELIVERY_TIMEOUT_MS=3000
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BASE_DELAY_MS=1000
DELIVERY_MAX_DELAY_MS=60000
